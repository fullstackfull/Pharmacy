APP_NAME=Laravel
# Production default: a copied-as-is .env should not run in local mode. Set to `local` only in your
# own development .env.
APP_ENV=production
# Leave this EMPTY and run `php artisan key:generate` after copying this file.
# The value that shipped here was a real, hardcoded key — identical in every copy of this
# platform, so anyone holding it can forge session cookies and decrypt anything encrypted
# with it. An example file must never carry one.
APP_KEY=
# Never true in production: it renders stack traces, file paths and query contents to whoever
# triggers an error. Set it to true locally in your own .env, not here.
APP_DEBUG=false
APP_MODE=live
APP_URL=http://localhost
LOG_CHANNEL=single
# In production set this to `warning` (or `error`) so request bodies and query contents are not
# written to logs at debug level.
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=6valley
DB_USERNAME=root
DB_PASSWORD=
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
NEXMO_KEY=
NEXMO_SECRET=
PURCHASE_CODE=
BUYER_USERNAME=
SOFTWARE_ID=MzE0NDg1OTc=

OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# The Developer Portal's "try it" console sends real requests at this shop's own API from the admin
# panel. Reads work with no setting at all; WRITES ARE OFF and stay off unless the line below is
# uncommented on an installation where sending one is acceptable — never the shop taking the orders,
# unless you mean it. Money, identity and removal endpoints are refused whatever this says.
# DEVELOPER_CONSOLE_ALLOW_WRITES=true

NGINX_PORT=8302
FORCE_HTTPS=true
CONTAINER_NAME_PREFIX=6valley-demo
