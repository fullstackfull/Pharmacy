
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
*.sql
# Dependencies
/vendor/

# Environment
.env
.env.*
!.env.example

# Secrets / certificates
*.pem
*.key
*.crt
*.p12
*.pfx
# PHPUnit run cache — a local artifact, regenerated on every test run
.phpunit.result.cache

# Node dependencies — 700+ packages, restored by `npm install`
/node_modules/

# Symlink created by `php artisan storage:link`, environment-specific
/public/storage

# Local browser-test output
/tests/browser/screenshots/

# Runtime storage. Receives user uploads in production, and staging-setup.sh
# extracts installation/backup/public.zip into it, so its contents are either
# regenerable or environment-specific. Files already tracked here stay tracked —
# an ignore rule does not untrack anything.
/storage/app/public/
